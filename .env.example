# Copy to .env for `netlify dev`, or set these in
# Netlify → Site configuration → Environment variables.

# Public URL of your Kimi-Audio server (see ./server).
# Leave unset to make users enter it in the console's Connection panel.
KIMI_BACKEND_URL=https://your-gpu-box.example.com

# Optional bearer token. When set here, use the console's Proxy mode so the
# key stays server-side and never reaches the browser.
KIMI_API_KEY=
